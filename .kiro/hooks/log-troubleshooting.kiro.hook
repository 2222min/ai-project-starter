{
  "enabled": true,
  "name": "Troubleshooting Log Reminder",
  "description": "After fixing a bug, reminds to document in troubleshooting log.",
  "version": "1",
  "when": {
    "type": "postToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "If you just fixed a bug or discovered a non-obvious pattern, check if it is already documented in docs/troubleshooting/log.md. If not, add a new entry with: Problem, Root Cause, Solution, Prevention. If this was routine code (not a bug fix), ignore."
  }
}